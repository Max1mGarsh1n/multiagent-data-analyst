# PostgreSQL (pgvector metadata DB + target source DB)
POSTGRES_PORT=5433
POSTGRES_PASSWORD=postgres
APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/analyst
SOURCE_DATABASE_URL=
SOURCE_SCHEMA=bookings

# Local LLM (OpenAI-compatible endpoint: Ollama / llama-server / LM Studio)
# For 32 GB RAM + 4 GB VRAM, qwen2.5-coder:7b (hybrid) or qwen2.5-coder:3b (fits in VRAM) works best.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:7b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1024

# Ollama server memory tuning (apply in host env or Docker)
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_MAX_LOADED_MODELS=1

# Schema RAG (CPU embeddings + lexical + FK neighbor expansion)
RAG_MODE=hybrid
RAG_TOP_K=8
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# SQL Agent & UI
SQL_MAX_ROWS=200
SQL_MAX_RETRIES=2
API_BASE_URL=http://localhost:8000
API_TIMEOUT_SECONDS=180
